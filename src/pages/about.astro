---
/**
 * About — ported from design-reference/About.dc.html.
 *
 * Departures from the prototype, all factual corrections:
 *  - It said links are re-verified "weekly"; the actual workflow runs nightly.
 *  - Its citation pointed at https://banglanlp-hub.github.io, which is not this site.
 *  - Its "Leaderboard scores link to their source" claim is restated as the policy it
 *    actually is, since most benchmarks still have no curated rows.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { stats, tasks } from '../lib/data.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const REPO = 'https://github.com/eliteresearchlab/BanglaNLP-Hub';

const bibtex = `@software{morol_banglanlp_hub,
  author  = {Morol, Md Kishor},
  title   = {BanglaNLP Hub},
  doi     = {10.5281/zenodo.22798635},
  url     = {${REPO}},
  license = {MIT}
}`;

const principles = [
  {
    title: 'Verified links',
    body: 'CI re-checks every external link nightly. Failures are collected in a single tracking issue, and the "✓ verified" chip on each resource shows when a human last confirmed it.',
  },
  {
    title: 'Sourced or absent',
    body: 'Nothing is estimated. Leaderboard rows require a citation to the paper reporting that exact number, so benchmarks with no curated rows show an empty state rather than a plausible guess.',
  },
  {
    title: 'Light by design',
    body: 'No trackers, no client framework. A handful of small vanilla scripts, built to load fast on mid-range phones and slow connections.',
  },
];
---

<Base title="About — BanglaNLP Hub" active="about">
  <main class="page page-wide">
    <PageHeader title="About" bn="পরিচিতি" />

    <div class="editorial-layout">
      <div class="editorial-body">
        <section class="prose">
          <p>
            <span class="bn" lang="bn">বাংলা</span>{' '}
            <strong>NLP Hub</strong> is a community-maintained catalog of research resources for Bengali,
            the world's sixth most spoken language, which remains under-resourced in NLP. We index
            papers, datasets, pretrained models, tools, and benchmark results in one place so that researchers
            spend less time hunting and more time building.
          </p>
          <p>
            The catalog is maintained by <a href="https://elitelab.ai/" target="_blank" rel="noopener"
><strong>ELITE Research Lab</strong></a> with contributions from the
            wider Bangla NLP community. All data lives in a <a href={REPO} target="_blank" rel="noopener"
>public GitHub repository</a
>; every link is re-verified nightly by CI, and the "✓ verified" chip next to each resource
            shows when it last resolved.
          </p>
          <p>
            Entries seeded from the original design prototype are being audited against ACL Anthology,
            arXiv, OpenAlex, and publisher records; several turned out to be inaccurate and were corrected
            or removed. Dataset size, license, and year have each had an audit pass. Unresolved fields
            remain listed in the repository.
          </p>
          <p>
            Corrections, additions, and new benchmark results are welcome. See <a
              href={`${base}/contribute`}>how to contribute</a
          >.
          </p>
        </section>

        <section class="section">
          <div class="section-heading">
            <div>
              <h2 class="section-title">How the catalog is maintained</h2>
              <p class="section-heading-bn bn" lang="bn">যেভাবে তথ্য যাচাই ও সাজানো হয়</p>
            </div>
          </div>
          <dl class="flow-list">
            {principles.map((p) => (
              <div>
                <dt>{p.title}</dt>
                <dd>{p.body}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>

      <aside class="editorial-aside" aria-label="Catalog overview">
        <h2>In the catalog</h2>
        <dl class="editorial-counts">
          <div><dt><a href={`${base}/papers`}>Papers</a></dt><dd>{stats.papers}</dd></div>
          <div><dt><a href={`${base}/datasets`}>Datasets</a></dt><dd>{stats.datasets}</dd></div>
          <div><dt><a href={`${base}/tasks`}>Models</a></dt><dd>{stats.models}</dd></div>
          <div><dt><a href={`${base}/tools`}>Tools</a></dt><dd>{stats.tools}</dd></div>
          <div><dt>Tasks</dt><dd>{tasks.length}</dd></div>
        </dl>
        <p>Counts are generated from the published catalog data.</p>
      </aside>
    </div>

    <section class="section">
      <div class="section-heading">
        <div>
          <h2 class="section-title">Cite this catalog</h2>
          <p class="section-heading-bn bn" lang="bn">উদ্ধৃতি</p>
        </div>
      </div>
      <p class="text-muted citation-description">
        This citation identifies the project. To cite a release, use its version DOI from <a
          href="https://doi.org/10.5281/zenodo.22798635" target="_blank" rel="noopener">Zenodo</a>.
      </p>
      <div class="citation-panel panel">
        <pre id="cite-bib" class="code-block">{bibtex}</pre>
        <button id="cite-copy" class="button button-sm" type="button">
          <Icon name="copy" size={16} />
          <span>Copy BibTeX</span>
        </button>
      </div>
      <p id="cite-status" class="copy-status text-muted" aria-live="polite"></p>
    </section>
  </main>
</Base>

<script>
  const btn = document.getElementById('cite-copy');
  const pre = document.getElementById('cite-bib');
  const status = document.getElementById('cite-status');
  btn?.addEventListener('click', async () => {
    const text = pre?.textContent ?? '';
    let copied = false;
    try {
      await navigator.clipboard.writeText(text);
      copied = true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.className = 'clipboard-fallback';
      document.body.appendChild(ta);
      ta.select();
      try {
        copied = document.execCommand('copy');
      } catch {}
      document.body.removeChild(ta);
        btn?.focus({ preventScroll: true });
    }
    if (status) status.textContent = copied ? 'BibTeX copied to clipboard.' : 'Copy failed. Select and copy the citation text.';
  });
</script>

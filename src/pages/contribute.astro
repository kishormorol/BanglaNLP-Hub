---
/**
 * Contribute — ported from design-reference/Contribute.dc.html.
 *
 * Three deliberate departures from the prototype:
 *  1. It referenced github.com/elite-research-lab/banglanlp-hub, which is not this
 *     repo. All links point at the real one.
 *  2. Its "Entry format" sample did not match the actual schema (no id/sizeN/desc,
 *     and a `paper:` field that does not exist). Replaced with a real dataset entry.
 *  3. Its submit button was a mock that only set a "submitted" flag. Here it builds
 *     a pre-filled GitHub issue against the Submit a resource template.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { tasks, contributors, papers, models, datasets, leaderboards } from '../lib/data.ts';

const REPO = 'https://github.com/eliteresearchlab/BanglaNLP-Hub';

const paperLink = new Map(papers.map((p) => [p.title, p.link]));
const modelByName = new Map(models.map((m) => [m.name, m]));
const datasetByName = new Map(datasets.map((d) => [d.name, d]));
const emptyLeaderboardCount = Object.values(leaderboards)
  .flat()
  .filter((leaderboard) => leaderboard.rows.length === 0).length;

const steps = [
  {
    n: '01',
    title: 'Fork the repo',
    body: 'eliteresearchlab/BanglaNLP-Hub — every resource is one small YAML record under data/datasets/, data/papers/, data/models.yaml, or data/tools.yaml.',
  },
  {
    n: '02',
    title: 'Add your YAML entry',
    body: 'Copy the format below and include a link you have actually opened. npm run validate checks the schema, the URL, and the verified date before CI will go green.',
  },
  {
    n: '03',
    title: 'Open a pull request',
    body: 'A maintainer reviews within about a week. On merge the site rebuilds and your entry goes live.',
  },
];

const sample = `# data/datasets/sentiment.yaml
- id: sentnob                      # unique, lowercase
  name: SentNoB
  task: sentiment                  # must match the filename
  size: "15,728 comments"          # human-readable
  sizeN: 15728                     # numeric, used for sorting
  license: CC BY-ND 4.0
  year: 2021
  source: SentNoB (Findings EMNLP 2021)
  link: https://github.com/KhondokerIslam/SentNoB
  verified: 2026-06-28             # the date YOU opened the link
  desc: Sentiment on noisy user comments from news and social platforms.
  bibtex: |                        # optional — omit if none exists upstream
    @inproceedings{islam-etal-2021-sentnob, ... }`;
---

<Base title="Contribute — BanglaNLP Hub" active="contribute">
  <main class="page page-wide">
    <PageHeader
      title="Contribute"
      bn="অবদান রাখুন"
      description="Every entry on this site lives as a YAML file in a public GitHub repository. The site rebuilds automatically when a pull request is merged — no CMS, no accounts, just Git."
    >
      <div class="page-header-actions"><a class="button button-primary" href="#submit-form">Submit a resource<Icon name="chevron-down" /></a></div>
    </PageHeader>

    <div class="editorial-layout">
      <section class="editorial-body">
        <div class="section-heading">
          <div>
            <h2 class="section-title">From discovery to catalog</h2>
            <p class="section-heading-bn bn" lang="bn">আবিষ্কার থেকে সংযোজন</p>
          </div>
        </div>
        <ol class="flow-list" aria-label="Contribution steps">
          {steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <aside class="editorial-aside">
        <div class="section-heading">
          <div>
            <h2>Keep every entry sourced</h2>
            <p class="section-heading-bn bn" lang="bn">প্রতিটি তথ্যের উৎস যাচাই করুন</p>
          </div>
        </div>
        <p>
          No invented scores, sizes, licenses, or BibTeX. Every leaderboard row must cite the paper
          reporting that exact number on that exact benchmark — which is why {emptyLeaderboardCount}
          leaderboards still render an empty state. A working link does not prove the metadata is
          right. If you are unsure about a field, leave it out and say so in the pull request; missing
          is fine, wrong is not.
          Full rules in <a href={`${REPO}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener"
>CONTRIBUTING.md</a
>.
        </p>
        <details class="entry-format">
          <summary>View a dataset YAML example</summary>
          <pre class="code-block">{sample}</pre>
        </details>
      </aside>
    </div>

    <section class="section">
      <div class="section-heading">
        <div>
          <h2 class="section-title">Submit a resource</h2>
          <p class="section-heading-bn bn" lang="bn">তথ্য যোগ করুন</p>
        </div>
      </div>
      <p class="section-description text-muted">
        Not comfortable with Git? Fill this in and we'll turn it into a pull request for you,
        credited to you.
      </p>
      <form id="submit-form" class="contribute-form panel" tabindex="-1">
        <label class="form-field">
          <span>Resource type</span>
          <select name="type">
            <option>Dataset</option>
            <option>Paper</option>
            <option>Model</option>
            <option>Tool</option>
            <option>Benchmark result</option>
          </select>
        </label>
        <label class="form-field">
          <span>Task</span>
          <select name="task">
            {tasks.map((t) => <option value={t.id}>{t.name}</option>)}
          </select>
        </label>
        <label class="form-field form-field-wide">
          <span>Name</span>
          <input name="name" required placeholder="e.g. SentNoB" />
        </label>
        <label class="form-field form-field-wide">
          <span>Link (dataset / paper / repo)</span>
          <input name="link" type="url" required placeholder="https://…" />
        </label>
        <label class="form-field form-field-wide">
          <span>Why it belongs in the catalog</span>
          <textarea name="why" rows="3" required placeholder="One or two sentences…"></textarea>
        </label>
        <div class="form-actions form-field-wide">
          <button class="button button-primary" type="submit">Submit for review</button>
          <span class="text-muted">Opens a pre-filled GitHub issue; maintainers review weekly.</span>
        </div>
      </form>
      <p class="text-muted direct-submit">
        Prefer to skip the form? Open the <a
          href={`${REPO}/issues/new?template=submit-resource.yml`}
          target="_blank"
          rel="noopener">Submit a resource</a
> issue directly.
      </p>
    </section>

    {
      contributors.length> 0 && (
        <section class="section contributors-section">
          <div class="section-heading">
            <h2 class="section-title">Contributors <span class="bn" lang="bn">অবদানকারী</span></h2>
          </div>
          <p class="section-description text-muted">
            Resources suggested by the community. Each paper's full author list is shown as
            published.
          </p>
          <div class="contributor-list">
            {contributors.map((c) => (
              <article class="panel contributor-card">
                <h3 class="resource-title">
                  <a href={`https://github.com/${c.github}`} target="_blank" rel="noopener">
                    {c.name}
                  </a>
                  <span class="text-muted contributor-handle">, @{c.github}</span>
                </h3>
                <ul class="contributor-entries">
                  {c.entries.map((e) => {
                    const model = e.kind === 'model' ? modelByName.get(e.title) : undefined;
                    const dataset = e.kind === 'dataset' ? datasetByName.get(e.title) : undefined;
                    const href =
                      paperLink.get(e.title) ??
                      model?.link ??
                      dataset?.link ??
                      `${REPO}/${e.pr ? `pull/${e.pr}` : `issues/${e.issue}`}`;
                    const caption =
                      e.authors ??
                      (model
                        ? [model.arch, model.params].filter(Boolean).join(', ')
                        : dataset
                          ? `${dataset.size}, ${dataset.license}`
                          : '');
                    return (
                      <li class="contributor-entry">
                        <a class="resource-title" href={href} target="_blank" rel="noopener">
                          {e.title}
                        </a>
                        {caption && <p class="metadata text-muted">{caption}</p>}
                      </li>
                    );
                  })}
                </ul>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </main>
</Base>

<script is:inline define:vars={{ REPO }}>
  document.getElementById('submit-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target;
    const f = new FormData(form);
    const sel = form.querySelector('select[name=task]');
    const taskId = f.get('task');
    const taskLabel = sel.options[sel.selectedIndex].textContent.trim();

    // Prefills the Submit-a-resource issue form. Query keys are the template's field
    // ids; the task dropdown's option text is "<id> — <name>", so match that exactly.
    const params = new URLSearchParams({
      template: 'submit-resource.yml',
      title: `[Resource] ${f.get('name')}`,
      'resource-type': f.get('type'),
      task: `${taskId} — ${taskLabel}`,
      name: f.get('name'),
      link: f.get('link'),
      why: f.get('why'),
    });
    window.open(`${REPO}/issues/new?${params}`, '_blank', 'noopener');
  });
</script>

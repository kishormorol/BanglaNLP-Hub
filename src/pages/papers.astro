---
/**
 * Papers — ported from design-reference/Papers.dc.html.
 *
 * Every paper is server-rendered; the island only shows/hides rows as filters
 * change, so the full list is present without JS.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import CatalogInitialState from '../components/CatalogInitialState.astro';
import { papers, tasks, taskName } from '../lib/data.ts';
import { hasBangla } from '../lib/text-patterns.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const list = [...papers].sort((a, b) => b.year - a.year);
const yearOpts = [...new Set(list.map((p) => p.year))].sort((a, b) => b - a);
const venueOpts = [...new Set(list.map((p) => p.venue))].sort();
---

<Base title="Papers — BanglaNLP Hub" active="papers">
  <main class="page">
    <PageHeader
      title="Papers"
      bn="গবেষণাপত্র"
      description={`${list.length} indexed publications on Bangla NLP, newest first.`}
    />

    <div class="filterbar" role="search" aria-label="Filter papers">
      <input
        class="field filter-search"
        id="f-q"
        type="search"
        maxlength="1000"
        placeholder="Filter by title or author…"
        aria-label="Filter papers"
      />
      <select class="field" id="f-year" aria-label="Filter by year">
        <option value="">Any year</option>
        {yearOpts.map((y) => <option value={String(y)}>{y}</option>)}
      </select>
      <select class="field" id="f-venue" aria-label="Filter by venue">
        <option value="">Any venue</option>
        {venueOpts.map((v) => <option value={v}>{v}</option>)}
      </select>
      <select class="field" id="f-task" aria-label="Filter by task">
        <option value="">All tasks</option>
        {tasks.map((t) => <option value={t.id}>{t.name}</option>)}
      </select>
      <button class="button button-sm" id="f-clear" type="button" hidden>Clear filters</button>
      <span class="text-muted" id="f-count" aria-live="polite">{list.length} shown</span>
    </div>

    <CatalogInitialState stage="start" />

    <div class="resource-list catalog-results">
      {
        list.map((p) => (
          <article
            class="resource-row papercard"
            id={p.id}
            tabindex="-1"
            data-year={p.year}
            data-venue={p.venue}
            data-task={p.task}
            data-text={`${p.title} ${p.authors}`.toLowerCase()}
          >
            <span class="mono metadata">{p.year}</span>
            <div class="row-main">
              <h2 class:list={['resource-title', hasBangla(p.title) && 'bn']} lang={hasBangla(p.title) ? 'bn' : undefined}><a class="card-link" href={p.link} target="_blank" rel="noopener">{p.title}</a></h2>
              <span class="row-meta">
                <span class={hasBangla(p.authors) ? 'bn' : undefined} lang={hasBangla(p.authors) ? 'bn' : undefined}>{p.authors}</span>, {taskName(p.task)}
                {p.note && <span>, {p.note}</span>}
              </span>
            </div>
            <span class="badge badge-accent">{p.venue}</span>
            <Icon name="arrow-up-right" size={16} />
          </article>
        ))
      }
      <div class="panel empty-state" id="f-empty" hidden>
        Nothing matches those filters. <a href={`${base}/contribute`}>Add a missing paper via PR</a>.
      </div>
    </div>
    <CatalogInitialState />
  </main>
</Base>

<script>
  import { initCatalogFilters } from '../lib/catalog-filters';

  const q = document.getElementById('f-q') as HTMLInputElement;
  const year = document.getElementById('f-year') as HTMLSelectElement;
  const venue = document.getElementById('f-venue') as HTMLSelectElement;
  const task = document.getElementById('f-task') as HTMLSelectElement;
  const count = document.getElementById('f-count');
  const empty = document.getElementById('f-empty');
  const cards = [...document.querySelectorAll<HTMLElement>('.papercard')];

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const hit =
        (!term || (c.dataset.text ?? '').includes(term)) &&
        (!year.value || c.dataset.year === year.value) &&
        (!venue.value || c.dataset.venue === venue.value) &&
        (!task.value || c.dataset.task === task.value);
      c.hidden = !hit;
      if (hit) shown++;
    }
    if (count) count.textContent = `${shown} shown`;
    if (empty) empty.hidden = shown > 0;
  }

  initCatalogFilters({ q, task, venue, year }, cards, apply, (card) => {
    card.focus({ preventScroll: true });
    card.scrollIntoView({ block: 'start' });
  });
</script>

---
/**
 * TaskDetail — ported from design-reference/TaskDetail.dc.html.
 *
 * The prototype was a single page keyed by `#taskId/tab`. These are static
 * routes, so the hash carries only the tab: /tasks/sentiment#leaderboard.
 *
 * All four panels are server-rendered; the island only toggles visibility,
 * sorts the dataset table, switches leaderboard pills, and copies BibTeX.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import DatasetName from '../../components/DatasetName.astro';
import Icon from '../../components/Icon.astro';
import { tasks, byTask } from '../../lib/data.ts';

export function getStaticPaths() {
  return tasks.map((t) => ({ params: { id: t.id } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { id } = Astro.params;
const task = tasks.find((t) => t.id === id)!;

// Default sort matches the prototype: year descending.
const datasets = [...byTask.datasets(task.id)].sort((a, b) => b.year - a.year);
const papers = [...byTask.papers(task.id)].sort((a, b) => b.year - a.year);
const paperById = new Map(papers.map((paper) => [paper.id, paper]));
const models = byTask.models(task.id);
// Curated boards first, so the default-selected pill is never an empty one.
const boards = [...byTask.leaderboards(task.id)].sort(
  (a, b) => (b.rows.length ? 1 : 0) - (a.rows.length ? 1 : 0),
);

// A board with zero rows carries no information, so it is treated as "not
// curated" for display instead of rendering a blank table.
const hasRows = boards.some((b) => b.rows.length> 0);
const topBoard = hasRows ? boards.find((b) => b.rows.length> 0)! : null;
const top = topBoard?.rows[0] ?? null;
const topPaper = top ? paperById.get(top.paperId)! : null;

const tabs = [
  ['datasets', `Datasets (${datasets.length})`],
  ['leaderboard', `Leaderboard (${boards.length})`],
  ['papers', `Papers (${papers.length})`],
  ['models', `Models (${models.length})`],
] as const;

const cols = [
  { key: 'name', label: 'Dataset', sticky: true },
  { key: 'size', label: 'Size' },
  { key: 'license', label: 'License' },
  { key: 'year', label: 'Year' },
  { key: null, label: 'Source paper' },
  { key: null, label: 'Link' },
];

---

<Base title={`${task.name} — BanglaNLP Hub`} description={task.desc} active="tasks">
  <main class="page task-detail">
    <PageHeader title={task.name} bn={task.bn} description={task.desc}>
      <nav slot="breadcrumbs" class="breadcrumbs" aria-label="Breadcrumb">
        <a href={`${base}/tasks`}>Tasks</a><span aria-hidden="true">/</span><span>{task.name}</span>
      </nav>
    </PageHeader>
    <div class="task-summary">
      <span><strong>{datasets.length}</strong>{datasets.length === 1 ? ' dataset' : ' datasets'}</span>
      <span><strong>{papers.length}</strong>{papers.length === 1 ? ' paper' : ' papers'}</span>
      {top && topBoard && topPaper && <span class="badge badge-success">Top listed: {top.model}, {top.score} {topBoard.metric} ({topPaper.year})</span>}
    </div>

    <div
      class="tabs"
      role="tablist"
      aria-label="Task resources"
    >
      {
        tabs.map(([tid, label]) => (
          <button
            role="tab"
            id={`tab-${tid}`}
            data-tab={tid}
            aria-controls={`panel-${tid}`}
            aria-selected={tid === 'datasets' ? 'true' : 'false'}
            tabindex={tid === 'datasets' ? '0' : '-1'}
          >
            {label}
          </button>
        ))
      }
    </div>

    <script is:inline>
      const detail = document.currentScript.parentElement;
      const initialTab = location.hash.slice(1);
      const selected = ['datasets', 'leaderboard', 'papers', 'models'].includes(initialTab) ? initialTab : 'datasets';
      detail.dataset.initialTab = selected;
      detail.querySelectorAll('[data-tab]').forEach(button => {
        button.setAttribute('aria-selected', String(button.dataset.tab === selected));
        button.tabIndex = button.dataset.tab === selected ? 0 : -1;
      });
    </script>

    {/* ---- Datasets ---- */}
    <div
      class="panel table-wrap"
      role="tabpanel"
      id="panel-datasets"
      aria-labelledby="tab-datasets"
      data-panel="datasets"
    >
      <table
        class="data-table"
        id="ds-table"
      >
        <thead>
          <tr>
            {
              cols.map((c) => (
                <th
                  scope="col"
                  class:list={[c.sticky && 'stickycol', c.key === 'year' && 'year-cell', c.key === 'size' && 'size-cell', c.label === 'Link' && 'source-cell']}
                  data-sort={c.key ?? undefined}
                  aria-sort={c.key === 'year' ? 'descending' : c.key ? 'none' : undefined}
                >
                  {c.key ? (
                    <button type="button" data-sort-button>
                      {c.label}<span data-ind aria-hidden={c.key === 'year' ? 'false' : 'true'}>{c.key && <Icon name="chevron-down" />}</span>
                    </button>
                  ) : c.label}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            datasets.map((d) => (
              <tr
                class="dsrow"
                data-name={d.name.toLowerCase()}
                data-size={d.sizeN}
                data-license={d.license.toLowerCase()}
                data-year={d.year}
              >
                <td class="stickycol">
                  <div class="resource-title"><DatasetName name={d.name} /></div>
                  <div class="metadata">{d.desc}</div>
                </td>
                <td class="mono size-cell">
                  {d.size}
                </td>
                <td>
                  <span class="badge">
                    {d.license}
                  </span>
                </td>
                <td class="mono row-meta year-cell">
                  {d.year}
                </td>
                <td class="metadata">{d.source}</td>
                <td class="source-cell">
                  <div class="metadata resource-actions">
                    <a
                      href={d.link}
                      target="_blank"
                      rel="noopener"
                      aria-label={`Download ${d.name}`}
                    >
                      Download <Icon name="arrow-up-right" />
                    </a>
                    {d.bibtex && (
                      <button
                        class="bibbtn button-sm"
                        data-bibtex={d.bibtex}
                      >
                        BibTeX
                      </button>
                    )}
                  </div>
                  <div class="metadata verification">
                    <Icon name="check" /> verified <time datetime={d.verified}>{d.verified}</time>
                  </div>
                </td>
              </tr>
            ))
          }
          {/* A task can legitimately have no datasets yet (vqa was the first).
              Without this the panel renders a bare header row and looks broken. */}
          {datasets.length === 0 && (
            <tr>
              <td colspan={cols.length}>
                <div class="empty-state">
                  No datasets curated for this task yet. <a href={`${base}/contribute`}>Add one via PR</a>.
                </div>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
    <p id="bib-copy-status" class="section-note" role="status" aria-live="polite"></p>

    {/* ---- Leaderboard ---- */}
    <div
      role="tabpanel"
      id="panel-leaderboard"
      aria-labelledby="tab-leaderboard"
      data-panel="leaderboard"
      hidden
    >
      {
        hasRows ? (
          <>
            <div class="leaderboard-filters">
              {boards.map((b, i) => (
                <button
                  class="button button-sm lbpill"
                  data-board={i}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {b.label}
                </button>
              ))}
            </div>
            {boards.map((b, i) => (
              <div class="lbpanel" data-board={i} hidden={i !== 0}>
                {b.rows.length === 0 ? (
                  // A task can carry several benchmarks with only some curated.
                  // An uncurated one gets the empty state, never a blank table.
                  <div class="empty-state">
                    No rows curated for {b.label} yet. <a href={`${base}/contribute`}>Contribute via PR</a>.
                  </div>
                ) : (
                <>
                <div class="section-note">
                  Results listed for{' '}
                  <span class="resource-title">{b.label}</span>, metric:{' '}
                  <span class="mono">{b.metric}</span>
                </div>
                <div class="table-wrap">
                  <table class="data-table leaderboard-table">
                    <thead>
                      <tr>
                        <th scope="col">
                          #
                        </th>
                        <th scope="col" class="stickycol">
                          Model
                        </th>
                        <th scope="col">
                          {b.metric}
                        </th>
                        <th scope="col">
                          Paper
                        </th>
                        <th scope="col" class="year-cell">
                          Year
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {b.rows.map((r, ri) => {
                        const source = paperById.get(r.paperId)!;
                        return (
                        <tr>
                          <td class="mono row-meta">
                            {ri + 1}
                          </td>
                          <td class="stickycol resource-title">
                            {r.model}
                            {ri === 0 && (
                              <span class="badge badge-success">
                                Top listed
                              </span>
                            )}
                          </td>
                          <td class="mono">
                            {r.score}
                          </td>
                          <td class="metadata">
                            <a href={source.link} target="_blank" rel="noopener">{source.title}</a>
                          </td>
                          <td class="mono row-meta year-cell">
                            {source.year}
                          </td>
                        </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
                </>
                )}
              </div>
            ))}
            <div class="section-note">
              Scores are community-reported; see linked papers for official numbers.{' '}
              <a href={`${base}/contribute`}>Report a correction</a>.
            </div>
          </>
        ) : (
          <div class="empty-state">
            No leaderboard curated yet. <a href={`${base}/contribute`}>Contribute via PR</a>.
          </div>
        )
      }
    </div>

    {/* ---- Papers ---- */}
    <div
      role="tabpanel"
      id="panel-papers"
      aria-labelledby="tab-papers"
      data-panel="papers"
      class="resource-list"
      hidden
    >
      {
        papers.map((p) => {
          return (
            <article
              class="resource-row"
            >
              <time class="row-meta mono" datetime={String(p.year)}>{p.year}</time>
              <div class="row-main">
                <h2 class="resource-title"><a class="card-link" href={p.link} target="_blank" rel="noopener">{p.title}</a></h2>
                <span class="metadata">
                  {p.authors}
                  {p.note && <span>, {p.note}</span>}
                </span>
              </div>
              <span class="badge badge-accent">
                {p.venue}
              </span>
            </article>
          );
        })
      }
      {/* A task can legitimately have no papers yet — `el` was added with none,
          because no Bangla-specific entity linking work was found. Without this
          the panel renders as an empty gap and reads as a broken page. */}
      {papers.length === 0 && (
        <p class="empty-state">
          No papers curated for this task yet. <a href={`${base}/contribute`}>Add one via PR</a>.
        </p>
      )}
    </div>

    {/* ---- Models ---- */}
    <div
      role="tabpanel"
      id="panel-models"
      aria-labelledby="tab-models"
      data-panel="models"
      class="resource-grid"
      hidden
    >
      {
        models.length ? (
          models.map((m) => (
            <article
              class="resource-card"
            >
              <h2 class="resource-title mono">
                {m.stage && (
                  <span class="badge badge-accent">
                    {m.stage === 'base' ? 'BASE' : 'FINE-TUNED'}
                  </span>
                )}
                <a class="card-link" href={m.link} target="_blank" rel="noopener">{m.name}</a>
              </h2>
              <div class="metadata">
                {[m.arch, m.params].filter(Boolean).join(', ')}
              </div>
              {m.note && (
                <div class="metadata">{m.note}</div>
              )}
              <div class="metadata verification">
                <Icon name="check" /> verified {m.verified}
              </div>
            </article>
          ))
        ) : (
          <div class="empty-state">
            No models catalogued for this task yet. <a href={`${base}/contribute`}>Add one via PR</a>.
          </div>
        )
      }
    </div>
    <script is:inline>
      const taskDetail = document.currentScript.parentElement;
      taskDetail.querySelectorAll('[data-panel]').forEach(panel => { panel.hidden = panel.dataset.panel !== taskDetail.dataset.initialTab; });
      delete taskDetail.dataset.initialTab;
    </script>
  </main>
</Base>

<script>
  const TABS = ['datasets', 'leaderboard', 'papers', 'models'];

  // ---- deep-linkable tabs: /tasks/<id>#leaderboard ----
  function showTab(name: string, push: boolean) {
    const tab = TABS.includes(name) ? name : 'datasets';
    document.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => {
      b.setAttribute('aria-selected', String(b.dataset.tab === tab));
      b.tabIndex = b.dataset.tab === tab ? 0 : -1;
    });
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
      p.hidden = p.dataset.panel !== tab;
    });
    if (push) history.replaceState(null, '', tab === 'datasets' ? location.pathname : `#${tab}`);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => {
    b.addEventListener('click', () => {
      if (b.dataset.tab) showTab(b.dataset.tab, true);
    });
    b.addEventListener('keydown', (event) => {
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      const current = tabs.indexOf(b);
      const next = event.key === 'ArrowRight'
        ? (current + 1) % tabs.length
        : event.key === 'ArrowLeft'
          ? (current - 1 + tabs.length) % tabs.length
          : event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? tabs.length - 1
              : -1;
      if (next < 0) return;
      event.preventDefault();
      const nextTab = tabs[next];
      if (!nextTab?.dataset.tab) return;
      nextTab.focus();
      showTab(nextTab.dataset.tab, true);
    });
  });
  window.addEventListener('hashchange', () => showTab(location.hash.slice(1), false));
  showTab(location.hash.slice(1), false);

  // ---- sortable dataset table ----
  const table = document.getElementById('ds-table') as HTMLTableElement | null;
  if (table) {
    const tbody = table.tBodies[0];
    let key = 'year';
    let dir = -1;

    table.querySelectorAll<HTMLButtonElement>('[data-sort-button]').forEach((button) => {
      button.addEventListener('click', () => {
        const th = button.closest('th');
        const k = th?.dataset.sort;
        if (!th || !k) return;
        if (k === key) dir = -dir;
        else {
          key = k;
          dir = k === 'size' || k === 'year' ? -1 : 1;
        }

        table.querySelectorAll<HTMLElement>('th[data-sort]').forEach((h) => {
          const active = h.dataset.sort === key;
          h.setAttribute('aria-sort', active ? (dir> 0 ? 'ascending' : 'descending') : 'none');
          const ind = h.querySelector('[data-ind]');
          if (ind) ind.setAttribute('aria-hidden', String(!active));
        });

        const rows = [...tbody.querySelectorAll<HTMLElement>('tr')];
        rows.sort((a, b) => {
          // `size` sorts on the numeric sizeN, never the display string.
          const attr = key === 'size' ? 'size' : key;
          const av = a.dataset[attr] ?? '';
          const bv = b.dataset[attr] ?? '';
          const numeric = key === 'size' || key === 'year';
          const x = numeric ? Number(av) : av;
          const y = numeric ? Number(bv) : bv;
          return (x < y ? -1 : x> y ? 1 : 0) * dir;
        });
        rows.forEach((r) => tbody.appendChild(r));
      });
    });
  }

  // ---- BibTeX copy ----
  document.querySelectorAll<HTMLButtonElement>('.bibbtn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.bibtex ?? '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.className = 'clipboard-fallback';
        document.body.appendChild(ta);
        ta.select();
        try {
          copied = document.execCommand('copy');
        } catch {}
        document.body.removeChild(ta);
        btn?.focus({ preventScroll: true });
      }
      const status = document.getElementById('bib-copy-status');
      if (status) status.textContent = copied ? 'BibTeX copied to clipboard.' : 'Could not copy BibTeX.';
      if (!copied) return;
      btn.textContent = 'Copied';
      btn.dataset.copied = 'true';
      setTimeout(() => {
        btn.textContent = 'BibTeX';
        delete btn.dataset.copied;
      }, 1600);
    });
  });

  // ---- leaderboard pill selector ----
  document.querySelectorAll<HTMLElement>('.lbpill').forEach((pill) => {
    pill.addEventListener('click', () => {
      const i = pill.dataset.board;
      document.querySelectorAll<HTMLElement>('.lbpill').forEach((p) => {
        const on = p.dataset.board === i;
        p.setAttribute('aria-pressed', String(on));
      });
      document.querySelectorAll<HTMLElement>('.lbpanel').forEach((p) => {
        p.hidden = p.dataset.board !== i;
      });
    });
  });
</script>

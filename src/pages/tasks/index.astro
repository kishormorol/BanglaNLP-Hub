---
/** Tasks catalog. */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { tasks, byTask } from '../../lib/data.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const cards = tasks.map((t) => {
  const boards = byTask.leaderboards(t.id);
  const board = boards.find((b) => b.rows.length > 0);
  const top = board?.rows[0];
  return {
    ...t,
    href: `${base}/tasks/${t.id}`,
    dCount: byTask.datasets(t.id).length,
    pCount: byTask.papers(t.id).length,
    mCount: byTask.models(t.id).length,
    leader: top ? top.model : '',
    leaderScore: top ? `${top.score} ${board!.metric}` : '',
    leaderBoard: top ? board!.label : '',
    hasLeader: Boolean(top),
  };
});
---

<Base title="Tasks — BanglaNLP Hub" active="tasks">
  <main class="page">
    <PageHeader
      title="Tasks"
      bn="কাজসমূহ"
      description="Every resource in the catalog is organized under a task. Each task page collects its datasets, leaderboard, papers, and model checkpoints."
    />
    <div class="section-heading">
      <div>
        <p class="section-heading-bn bn" lang="bn">প্রতিটি কাজের গবেষণা, ডেটাসেট ও মডেল একসঙ্গে</p>
      </div>
    </div>

    <div class="task-directory">
      {cards.map((t) => (
        <article class="task-directory-row">
          <div class="task-directory-main">
            <h2 class="task-directory-title"><a class="card-link" href={t.href}>{t.name}</a></h2>
            <span class="bn task-directory-bn" lang="bn">{t.bn}</span>
            <p class="task-directory-description">{t.desc}</p>
          </div>
          <dl class="task-directory-counts">
            <div><dt>Datasets</dt><dd>{t.dCount}</dd></div>
            <div><dt>Papers</dt><dd>{t.pCount}</dd></div>
            <div><dt>Models</dt><dd>{t.mCount}</dd></div>
          </dl>
          {t.hasLeader && <p class="task-directory-leader">
            Top listed: <span class="task-leader-name">{t.leader}</span>{' '}
            <span class="mono">{t.leaderScore}</span> on {t.leaderBoard}
          </p>}
        </article>
      ))}
    </div>
  </main>
</Base>

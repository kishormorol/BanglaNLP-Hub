---
/**
 * Datasets — ported from design-reference/Datasets.dc.html.
 *
 * One deliberate departure: the prototype's genBibtex() SYNTHESISED an @misc
 * entry whenever a dataset had no real bibtex field. That contradicts the rule
 * published in CONTRIBUTING.md ("no invented BibTeX") and TaskDetail's
 * behaviour. Rows without BibTeX say so and link to the contribution guide instead.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import CatalogInitialState from '../components/CatalogInitialState.astro';
import DatasetName from '../components/DatasetName.astro';
import { datasets, tasks, taskName } from '../lib/data.ts';
import { hasBangla } from '../lib/text-patterns.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Classify catalog text, not the underlying dataset's verified licensing status.
const noncommercialLicense = /NC|Non-comm/i;
const researchLicense = /research/i;
const licenseGroup = (l: string) =>
  noncommercialLicense.test(l) ? 'nc' : researchLicense.test(l) ? 'research' :
    ['MIT', 'Apache 2.0', 'CC0', 'ODC-BY', 'CC BY 4.0', 'CC BY-SA 4.0'].includes(l) ? 'open' : 'other';

const rows = [...datasets].sort((a, b) => b.year - a.year || a.name.localeCompare(b.name));
const yearOpts = [...new Set(rows.map((d) => d.year))].sort((a, b) => b - a);
---

<Base title="Datasets — BanglaNLP Hub" active="datasets">
  <main class="page">
    <PageHeader
      title="Datasets"
      bn="ডেটাসেট"
      description={`${rows.length} Bangla datasets across ${tasks.length} tasks. Select a dataset name for details and a citation.`}
    />

    <div class="filterbar" role="search" aria-label="Filter datasets">
      <input
        class="field filter-search"
        id="f-q"
        type="search"
        maxlength="1000"
        placeholder="Filter by name or description…"
        aria-label="Filter datasets"
      />
      <select class="field" id="f-task" aria-label="Filter by task">
        <option value="">All tasks</option>
        {tasks.map((t) => <option value={t.id}>{t.name}</option>)}
      </select>
      <select class="field" id="f-license" aria-label="Filter by license">
        <option value="">Any license</option>
        <option value="open">Open / permissive</option>
        <option value="nc">Non-commercial</option>
        <option value="research">Research only</option>
        <option value="other">Other / restricted</option>
      </select>
      <select class="field" id="f-year" aria-label="Filter by year">
        <option value="">Any year</option>
        {yearOpts.map((y) => <option value={String(y)}>{y}</option>)}
      </select>
      <button class="button button-sm" id="f-clear" type="button" hidden>Clear filters</button>
      <span class="text-muted" id="f-count" aria-live="polite">{rows.length} shown</span>
    </div>

    <CatalogInitialState stage="start" />

    <div class="panel table-wrap catalog-results">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col" class="stickycol">Dataset</th>
            <th scope="col">Task</th>
            <th scope="col" class="size-cell">Size</th>
            <th scope="col">License</th>
            <th scope="col" class="year-cell">Year</th>
            <th scope="col" class="source-cell">Source</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((d) => (
              <>
                <tr
                  class="dsrow"
                  id={d.id}
                  data-id={d.id}
                  data-task={d.task}
                  data-year={d.year}
                  data-license={licenseGroup(d.license)}
                  data-text={`${d.name} ${d.desc} ${d.source}`.toLowerCase()}
                >
                  <td class="stickycol">
                    <button type="button" class="ds-toggle" aria-expanded="false" aria-controls={`detail-${d.id}`}>
                      <Icon name="chevron-down" size={16} />
                      <span class:list={['resource-title', hasBangla(d.name) && 'bn']} lang={hasBangla(d.name) ? 'bn' : undefined}><DatasetName name={d.name} /></span>
                    </button>
                  </td>
                  <td><span class="badge badge-accent">{taskName(d.task)}</span></td>
                  <td class="mono metadata size-cell">{d.size}</td>
                  <td><span class="badge">{d.license}</span></td>
                  <td class="mono metadata year-cell">{d.year}</td>
                  <td class="source-cell">
                    <a class="source-link" href={d.link} target="_blank" rel="noopener" data-stop aria-label={`Open source for ${d.name}`}>
                      Open source <Icon name="arrow-up-right" size={16} />
                    </a>
                    <span class="text-muted metadata verification">Verified <time datetime={d.verified}>{d.verified}</time></span>
                  </td>
                </tr>
                <tr class="dsdetail" id={`detail-${d.id}`} data-for={d.id} hidden>
                  <td colspan="6">
                    <div class="dataset-detail">
                      <div class:list={['resource-description', hasBangla(d.desc) && 'bn']} lang={hasBangla(d.desc) ? 'bn' : undefined}>
                        {d.desc}{' '}
                        <span class="text-muted">
                          Source: <span class={hasBangla(d.source) ? 'bn' : undefined} lang={hasBangla(d.source) ? 'bn' : undefined}>{d.source}</span>.
                        </span>
                      </div>
                      {d.bibtex ? (
                        <div class="bibtex-panel">
                          <pre class="code-block">{d.bibtex}</pre>
                          <button
                            class="button button-sm bibbtn"
                            type="button"
                            data-bibtex={d.bibtex}
                          >
                            Copy BibTeX
                          </button>
                          <span class="copy-status" aria-live="polite" />
                        </div>
                      ) : (
                        <div class="empty-state">
                          No BibTeX on file for this dataset. Rather than generate one, we leave it
                          out. <a href={`${base}/contribute`}>Add the published entry via PR</a>.
                        </div>
                      )}
                    </div>
                  </td>
                </tr>
              </>
            ))
          }
        </tbody>
      </table>
      <div class="empty-state" id="f-empty" hidden>
        Nothing matches those filters. <a href={`${base}/contribute`}>Add a missing dataset via PR</a>.
      </div>
    </div>
    <CatalogInitialState />
  </main>
</Base>

<script>
  import { initCatalogFilters } from '../lib/catalog-filters';

  const q = document.getElementById('f-q') as HTMLInputElement;
  const task = document.getElementById('f-task') as HTMLSelectElement;
  const lic = document.getElementById('f-license') as HTMLSelectElement;
  const year = document.getElementById('f-year') as HTMLSelectElement;
  const count = document.getElementById('f-count');
  const empty = document.getElementById('f-empty');
  const rows = [...document.querySelectorAll<HTMLElement>('.dsrow')];
  const detailFor = (id: string) =>
    document.querySelector<HTMLElement>(`.dsdetail[data-for="${id}"]`);

  function setOpen(id: string, open: boolean) {
    const row = rows.find((r) => r.dataset.id === id);
    const det = detailFor(id);
    if (!row || !det) return;
    det.hidden = !open || row.hidden;
    if (open) row.setAttribute('data-open', '');
    else row.removeAttribute('data-open');
    row.querySelector('.ds-toggle')?.setAttribute('aria-expanded', String(open));
  }

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const r of rows) {
      const hit =
        (!term || (r.dataset.text ?? '').includes(term)) &&
        (!task.value || r.dataset.task === task.value) &&
        (!lic.value || r.dataset.license === lic.value) &&
        (!year.value || r.dataset.year === year.value);
      r.hidden = !hit;
      const det = detailFor(r.dataset.id!);
      if (det) det.hidden = !hit || !r.hasAttribute('data-open');
      if (hit) shown++;
    }
    if (count) count.textContent = `${shown} shown`;
    if (empty) empty.hidden = shown > 0;
  }

  rows.forEach((r) => {
    r.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-stop]')) return;
      const id = r.dataset.id!;
      setOpen(id, !r.hasAttribute('data-open'));
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.bibbtn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const text = btn.dataset.bibtex ?? '';
      try {
        await navigator.clipboard.writeText(text);
        showCopyResult(btn, true);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.className = 'clipboard-fallback';
        ta.setAttribute('aria-hidden', 'true');
        ta.tabIndex = -1;
        document.body.appendChild(ta);
        ta.select();
        let copied = false;
        try {
          copied = document.execCommand('copy');
        } catch {}
        document.body.removeChild(ta);
        btn?.focus({ preventScroll: true });
        showCopyResult(btn, copied);
      }
    });
  });

  function showCopyResult(btn: HTMLButtonElement, copied: boolean) {
    const status = btn.parentElement?.querySelector<HTMLElement>('.copy-status');
    if (status) status.textContent = copied ? 'Copied' : 'Copy failed';
    if (copied) btn.setAttribute('data-copied', '');
    setTimeout(() => {
      if (status) status.textContent = '';
      btn.removeAttribute('data-copied');
    }, 1600);
  }

  initCatalogFilters({ q, task, license: lic, year }, rows, apply, (row) => {
    setOpen(row.id, true);
    row.querySelector<HTMLButtonElement>('.ds-toggle')?.focus({ preventScroll: true });
    row.scrollIntoView({ block: 'start' });
  });
</script>

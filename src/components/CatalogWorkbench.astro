---
import '../styles/catalog-workbench.css';
import Icon from './Icon.astro';
import { datasets, models, papers, stats, tools, taskName } from '../lib/data';
import { hasBangla } from '../lib/text-patterns.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const collections = [
  {
    id: 'papers',
    name: 'Papers',
    bn: 'প্রবন্ধ',
    count: stats.papers,
    href: `${base}/papers`,
    rows: papers.slice(0, 2).map((paper) => ({
      title: paper.title,
      meta: `${paper.venue}, ${paper.year}, ${taskName(paper.task)}`,
      href: paper.link,
    })),
  },
  {
    id: 'datasets',
    name: 'Datasets',
    bn: 'ডেটাসেট',
    count: stats.datasets,
    href: `${base}/datasets`,
    rows: datasets.slice(0, 2).map((dataset) => ({
      title: dataset.name,
      meta: `${taskName(dataset.task)}, ${dataset.year}`,
      href: dataset.link,
    })),
  },
  {
    id: 'models',
    name: 'Models',
    bn: 'মডেল',
    count: stats.models,
    href: `${base}/tasks`,
    rows: models.slice(0, 2).map((model) => ({
      title: model.name,
      meta: `${model.arch}, ${taskName(model.tasks[0])}`,
      href: model.link,
    })),
  },
  {
    id: 'tools',
    name: 'Tools',
    bn: 'সরঞ্জাম',
    count: stats.tools,
    href: `${base}/tools`,
    rows: tools.slice(0, 2).map((tool) => ({
      title: tool.name,
      meta: `${tool.author}, ${tool.lang}`,
      href: tool.link,
    })),
  },
];

// ISO-GLOW's 30° projection: x,y,z -> ((x-y)cos30, (x+y)sin30-z).
// These face matrices keep every face aligned to that shared projection.
const C = Math.cos(Math.PI / 6);
const S = Math.sin(Math.PI / 6);
const P = (x: number, y: number, z: number) => [(x - y) * C + 120, (x + y) * S - z + 124];
const D = (x: number, y: number, z: number) => [(x - y) * C, (x + y) * S - z];
const plane = (origin: [number, number, number], u: [number, number, number], v: [number, number, number]) => {
  const [ox, oy] = P(...origin);
  const [ux, uy] = D(...u);
  const [vx, vy] = D(...v);
  return `matrix(${ux} ${uy} ${vx} ${vy} ${ox} ${oy})`;
};
const TOP = (x: number, y: number, z: number) => plane([x, y, z], [1, 0, 0], [0, 1, 0]);
const FRONT = (x: number, y: number, z: number) => plane([x, y, z], [1, 0, 0], [0, 0, -1]);
const SIDE = (x: number, y: number, z: number) => plane([x, y, z], [0, -1, 0], [0, 0, -1]);

const blocks = collections.map((collection, index) => ({
  ...collection,
  x: index % 2 ? 164 : 28,
  y: index < 2 ? 28 : 148,
  z: 8,
  w: 78,
  d: 60,
  h: collection.id === 'papers' ? 60 : 48,
})).sort((a, b) => a.x + a.y - b.x - b.y);
const corners = [
  [0, 0, -8], [280, 0, -8], [0, 230, -8], [280, 230, -8],
  ...blocks.flatMap(({ x, y, z, w, d, h }) => [[x, y, z + h], [x + w, y, z + h], [x, y + d, z + h], [x + w, y + d, z + h]]),
];
const projected = corners.map(([x, y, z]) => P(x, y, z));
const minX = Math.min(...projected.map(([x]) => x)) - 24;
const minY = Math.min(...projected.map(([, y]) => y)) - 24;
const viewBox = `${minX} ${minY} ${Math.max(...projected.map(([x]) => x)) - minX + 24} ${Math.max(...projected.map(([, y]) => y)) - minY + 24}`;
---

<section class="catalog-workbench" data-workbench aria-labelledby="workbench-title">
  <h2 id="workbench-title" class="workbench-heading">Explore the catalog <span class="bn" lang="bn">গবেষণার সূচি</span></h2>
  <div class="workbench-stage">
    <div class="workbench-figure-wrap">
      <svg class="workbench-figure" viewBox={viewBox} role="img" aria-label="Isometric Bangla research desk with four blocks for papers, datasets, models and tools. Choose a category to illuminate its block and browse its resources.">
        <defs>
          <filter id="workbench-glow" x="-80%" y="-80%" width="260%" height="260%">
            <feGaussianBlur stdDeviation="4" result="blur" />
            <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
        </defs>
        <g class="iso-plate">
          <g transform={TOP(0, 0, 0)}><rect class="iso-plate-top" width="280" height="230" rx="5" /></g>
          <g transform={FRONT(0, 230, 0)}><rect class="iso-plate-front" width="280" height="8" /></g>
          <g transform={SIDE(280, 230, 0)}><rect class="iso-plate-side" width="230" height="8" /></g>
          <g transform={TOP(0, 0, 0)}><path class="iso-guide" d="M16 118h248M136 16v198" /></g>
        </g>
        {blocks.map(({ id, name, bn, x, y, z, w, d, h }) => <g class:list={['workbench-object', id === 'papers' && 'is-lit']} data-object={id}>
          <g transform={TOP(x, y, z + h)}>
            <rect class="iso-top" width={w} height={d} />
            <g class="iso-details">
              {id === 'papers' ? <text class="iso-bangla bn" lang="bn" x={w / 2} y="38" text-anchor="middle">ব</text> : <path class="iso-hairline" d="M14 16h50M14 25h50M14 34h34" />}
            </g>
          </g>
          <g transform={SIDE(x + w, y + d, z + h)}><rect class="iso-side" width={d} height={h} /></g>
          <g transform={FRONT(x, y + d, z + h)}>
            <rect class="iso-front" width={w} height={h} />
            <g class="iso-details">
              <rect class="iso-inset" x="5" y="4" width={w - 10} height={h - 8} rx="2" />
              <text class="iso-label" x={w / 2} y={h / 2 - 5} text-anchor="middle">{name}</text>
              <text class="iso-label-bn bn" lang="bn" x={w / 2} y={h / 2 + 12} text-anchor="middle">{bn}</text>
            </g>
          </g>
        </g>)}
      </svg>
      <div class="workbench-caption-row">
        <p class="workbench-caption">Choose a collection to light and lift its block, then explore the resources inside.</p>
        <button class="button button-sm workbench-motion-toggle" type="button" data-motion-toggle disabled>Pause motion</button>
      </div>
    </div>

    <div class="workbench-console">
      <div class="console-topline"><span>Catalog index</span><span class="bn" lang="bn">বাংলা এনএলপি</span></div>
      <p class="console-prompt">Select a collection</p>
      <div class="workbench-controls" role="group" aria-label="Choose a catalog collection">
        {collections.map((collection) => <button class="collection-button" type="button" data-select={collection.id} aria-controls={`workbench-panel-${collection.id}`} aria-pressed={collection.id === 'papers' ? 'true' : 'false'} disabled>
          <span class="collection-name">{collection.name}<span class="bn collection-bn" lang="bn">{collection.bn}</span></span>
          <span class="collection-count">{collection.count.toLocaleString('en-US')}</span>
        </button>)}
      </div>
      <p class="workbench-readout" aria-live="polite" aria-atomic="true"><strong>{stats.papers.toLocaleString('en-US')}</strong><span class="workbench-readout-label"> papers indexed</span><span class="workbench-readout-bn bn" lang="bn">গবেষণাপত্র</span></p>
      <div class="workbench-panels">
        {collections.map((collection) => <section class="collection-panel" id={`workbench-panel-${collection.id}`} data-panel={collection.id} hidden={collection.id !== 'papers'} aria-label={`${collection.name} in the Bangla NLP catalog`}>
          <div class="panel-heading"><h3>{collection.name} <span class="bn" lang="bn">{collection.bn}</span></h3><a href={collection.href}>{collection.id === 'models' ? 'Browse by task' : 'View all'}<Icon name="arrow-up-right" /></a></div>
          {collection.rows.length ? <ul>{collection.rows.map((row) => <li><a href={row.href} target="_blank" rel="noopener noreferrer"><span class:list={['resource-name', hasBangla(row.title) && 'bn']} lang={hasBangla(row.title) ? 'bn' : undefined}>{row.title}</span><span class:list={['resource-meta', hasBangla(row.meta) && 'bn']} lang={hasBangla(row.meta) ? 'bn' : undefined}>{row.meta}</span><span class="resource-arrow"><Icon name="arrow-up-right" /></span></a></li>)}</ul> : <p class="collection-empty">Entries will appear here as they are verified.</p>}
        </section>)}
      </div>
      <p class="console-footnote">A selection from the published catalog. Open any entry to visit its source.</p>
    </div>
  </div>
  <noscript><style>
    .workbench-panels { display: block; }
    .collection-panel[hidden] { visibility: visible; }
    .workbench-controls, [data-motion-toggle] { display: none; }
  </style></noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-workbench]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-select]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const count = root.querySelector<HTMLElement>('.workbench-readout strong');
    const readout = root.querySelector<HTMLElement>('.workbench-readout');
    if (!buttons.length || !panels.length || !count || !readout) return;

    const label = root.querySelector<HTMLElement>('.workbench-readout-label');
    const bengaliLabel = root.querySelector<HTMLElement>('.workbench-readout-bn');
    const figure = root.querySelector<SVGSVGElement>('.workbench-figure');
    const collections = buttons.map((button) => {
      const id = button.dataset.select ?? '';
      return {
        id,
        button,
        object: root.querySelector<SVGGElement>(`[data-object="${id}"]`),
        panel: panels.find((item) => item.dataset.panel === id),
        total: button.querySelector<HTMLElement>('.collection-count')?.textContent?.trim() ?? '0',
        name: button.querySelector<HTMLElement>('.collection-name')?.firstChild?.textContent?.trim() ?? 'resources',
        bn: button.querySelector<HTMLElement>('.collection-bn')?.textContent?.trim() ?? '',
      };
    });
    if (!label || !bengaliLabel || !figure || collections.some((item) => !item.panel)) return;

    root.dataset.enhanced = 'true';
    const motionButton = root.querySelector<HTMLButtonElement>('[data-motion-toggle]');
    let motionPaused = false;
    try { motionPaused = sessionStorage.bnlpMotionPaused === 'true'; } catch {}
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = true;
    let pointerInside = false;
    let bounds: DOMRect | null = null;
    let pointerX = 0;
    let pointerY = 0;
    let refreshBounds = false;
    let frame = 0;
    let observer: IntersectionObserver | undefined;
    let bfcacheHover = false;

    const syncAmbientMotion = () => {
      root.dataset.animate = String(inView && !document.hidden && !reducedMotion.matches && !motionPaused);
    };
    const canTilt = () => !motionPaused && pointerInside && inView && !document.hidden && finePointer.matches && !reducedMotion.matches;
    const stopTilt = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      refreshBounds = false;
      pointerInside = false;
      bounds = null;
      figure.style.removeProperty('--workbench-tilt-x');
      figure.style.removeProperty('--workbench-tilt-y');
      root.removeAttribute('data-pointer-tilt');
    };
    const renderTilt = () => {
      frame = 0;
      if (!canTilt()) {
        stopTilt();
        return;
      }
      if (refreshBounds) {
        bounds = figure.getBoundingClientRect();
        refreshBounds = false;
      }
      if (!bounds?.width || !bounds.height) return;

      const yaw = Math.max(-3, Math.min(3, ((pointerX - bounds.left) / bounds.width - 0.5) * 6));
      const pitch = Math.max(-3, Math.min(3, (0.5 - (pointerY - bounds.top) / bounds.height) * 6));
      if (!yaw && !pitch) {
        figure.style.removeProperty('--workbench-tilt-x');
        figure.style.removeProperty('--workbench-tilt-y');
        root.removeAttribute('data-pointer-tilt');
        return;
      }
      figure.style.setProperty('--workbench-tilt-x', `${yaw.toFixed(2)}deg`);
      figure.style.setProperty('--workbench-tilt-y', `${pitch.toFixed(2)}deg`);
      root.dataset.pointerTilt = 'true';
    };
    const scheduleTilt = (updateBounds = false) => {
      refreshBounds ||= updateBounds;
      if (!frame) frame = requestAnimationFrame(renderTilt);
    };
    const onPointerEnter = (event: PointerEvent) => {
      if (motionPaused || !finePointer.matches || reducedMotion.matches || event.pointerType === 'touch') return;
      pointerInside = true;
      bounds = figure.getBoundingClientRect();
      pointerX = event.clientX;
      pointerY = event.clientY;
      scheduleTilt();
    };
    const onPointerMove = (event: PointerEvent) => {
      if (!motionPaused && !pointerInside && finePointer.matches && !reducedMotion.matches && figure.matches(':hover')) {
        pointerInside = true;
        bounds = figure.getBoundingClientRect();
      }
      if (!pointerInside) return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      scheduleTilt();
    };
    const onBoundsChange = () => {
      if (pointerInside) scheduleTilt(true);
    };
    const onPreferenceChange = () => {
      syncAmbientMotion();
      if (!finePointer.matches || reducedMotion.matches) {
        stopTilt();
        return;
      }
      resumeHoveredPointer();
    };
    const onVisibilityChange = () => {
      syncAmbientMotion();
      if (document.hidden) {
        bfcacheHover = pointerInside || figure.matches(':hover');
        stopTilt();
      } else {
        bfcacheHover = false;
        resumeHoveredPointer();
      }
    };
    const resumeHoveredPointer = () => {
      if (motionPaused || !figure.matches(':hover') || !finePointer.matches || reducedMotion.matches || document.hidden || !inView) return;
      pointerInside = true;
      bounds = figure.getBoundingClientRect();
      scheduleTilt();
    };
    const dispose = () => {
      root.dataset.animate = 'false';
      stopTilt();
      figure.removeEventListener('pointerenter', onPointerEnter);
      figure.removeEventListener('pointermove', onPointerMove);
      figure.removeEventListener('pointerleave', stopTilt);
      window.removeEventListener('resize', onBoundsChange);
      window.removeEventListener('scroll', onBoundsChange, true);
      window.removeEventListener('pagehide', onPageHide);
      window.removeEventListener('pageshow', onPageShow);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      finePointer.removeEventListener('change', onPreferenceChange);
      reducedMotion.removeEventListener('change', onPreferenceChange);
      observer?.disconnect();
    };
    const onPageHide = (event: PageTransitionEvent) => {
      bfcacheHover = event.persisted && (bfcacheHover || pointerInside || figure.matches(':hover'));
      if (event.persisted) {
        root.dataset.animate = 'false';
        stopTilt();
      }
      else dispose();
    };
    const onPageShow = (event: PageTransitionEvent) => {
      syncAmbientMotion();
      if (!event.persisted || !bfcacheHover) return;
      bfcacheHover = false;
      resumeHoveredPointer();
    };

    if (motionButton) {
      motionButton.disabled = false;
      motionButton.textContent = motionPaused ? 'Resume motion' : 'Pause motion';
      motionButton.addEventListener('click', () => {
        motionPaused = !motionPaused;
        try { sessionStorage.bnlpMotionPaused = String(motionPaused); } catch {}
        motionButton.textContent = motionPaused ? 'Resume motion' : 'Pause motion';
        root.dataset.pointerMotion = 'false';
        stopTilt();
        syncAmbientMotion();
      });
    }
    syncAmbientMotion();
    figure.addEventListener('pointerenter', onPointerEnter);
    figure.addEventListener('pointermove', onPointerMove, { passive: true });
    figure.addEventListener('pointerleave', stopTilt);
    window.addEventListener('resize', onBoundsChange, { passive: true });
    window.addEventListener('scroll', onBoundsChange, { passive: true, capture: true });
    window.addEventListener('pagehide', onPageHide);
    window.addEventListener('pageshow', onPageShow);
    document.addEventListener('visibilitychange', onVisibilityChange);
    finePointer.addEventListener('change', onPreferenceChange);
    reducedMotion.addEventListener('change', onPreferenceChange);
    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        syncAmbientMotion();
        if (!inView) stopTilt();
        else resumeHoveredPointer();
      });
      observer.observe(figure);
    }

    const select = (id: string, pointerAction = false) => {
      const selectedItem = collections.find((item) => item.id === id);
      if (!selectedItem) return;
      // Keyboard selection stays immediate; pointer selection gets the brief spatial feedback.
      root.dataset.pointerMotion = String(pointerAction && !motionPaused);
      if (!pointerAction) stopTilt();
      collections.forEach((item) => {
        const selected = item === selectedItem;
        item.button.setAttribute('aria-pressed', String(selected));
        item.object?.classList.toggle('is-lit', selected);
      });
      panels.forEach((item) => { item.hidden = item !== selectedItem.panel; });
      count.textContent = selectedItem.total;
      label.textContent = ` ${selectedItem.name.toLowerCase()} indexed`;
      bengaliLabel.textContent = selectedItem.bn;
    };

    buttons.forEach((button) => {
      button.disabled = false;
      button.addEventListener('click', (event) => select(button.dataset.select ?? '', event.detail > 0));
    });
    select(buttons[0].dataset.select ?? '');
  });
</script>

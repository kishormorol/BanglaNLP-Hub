---
import Search from './Search.astro';
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { active?: string; }
const { active = '' } = Astro.props;
const links = [
  ['tasks', 'Tasks', 'কাজসমূহ'],
  ['datasets', 'Datasets', 'ডেটাসেট'],
  ['papers', 'Papers', 'প্রবন্ধ'],
  ['tools', 'Tools', 'সরঞ্জাম'],
];
---
<header class="site-header">
  <div class="navbar">
    <a class="brand" href={base + '/'} aria-label="BanglaNLP Hub home">
      <span class="brand-mark bn" lang="bn">ব</span>
      <span><span class="brand-bn bn" lang="bn">বাংলা</span> NLP <span class="text-muted">Hub</span></span>
    </a>
    <nav id="primary-nav" class="navrow" aria-label="Primary">
      {links.map(([id, label, bn]) => <a class="navlink" href={base + '/' + id} aria-current={id === active ? 'page' : undefined}><span class="nav-label">{label}</span><span class="nav-bn bn" lang="bn">{bn}</span></a>)}
      <a class="navlink nav-contribute" href={base + '/contribute'} aria-current={active === 'contribute' ? 'page' : undefined}><span class="nav-label">Contribute</span><span class="nav-bn bn" lang="bn">অবদান</span></a>
      <a class="navlink nav-secondary" href={base + '/about'} aria-current={active === 'about' ? 'page' : undefined}><span class="nav-label">About</span><span class="nav-bn bn" lang="bn">পরিচিতি</span></a>
    </nav>
    <Search variant="nav" id="nav-search" />
    <div class="nav-actions">
      <button id="theme-toggle" class="button button-icon" type="button" aria-label="Switch to dark theme" aria-pressed="false">
        <span class="theme-moon"><Icon name="moon" /></span><span class="theme-sun"><Icon name="sun" /></span>
      </button>
      <a class="button contribute-link" href={base + '/contribute'}><span class="nav-label">Contribute</span><span class="nav-bn bn" lang="bn">অবদান</span><Icon name="arrow-up-right" /></a>
      <button id="nav-menu-toggle" class="button button-icon navtoggle" type="button" aria-label="Open menu" aria-controls="primary-nav" aria-expanded="false">
        <span class="menu-open"><Icon name="menu" /></span><span class="menu-close"><Icon name="close" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const themeButton = document.getElementById('theme-toggle');
  const syncTheme = () => {
    const dark = document.documentElement.classList.contains('dark');
    document.querySelectorAll<HTMLSourceElement>('[data-theme-art]').forEach(source => { source.media = dark ? 'all' : 'not all'; });
    themeButton?.setAttribute('aria-pressed', String(dark));
    themeButton?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  };
  syncTheme();
  themeButton?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.bnlpTheme = dark ? 'dark' : 'light'; } catch {}
    syncTheme();
  });

  const menuButton = document.getElementById('nav-menu-toggle');
  const nav = document.getElementById('primary-nav');
  const setOpen = (open: boolean, motion = false) => {
    if (nav) nav.dataset.motion = String(motion);
    nav?.classList.toggle('open', open);
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuButton?.addEventListener('click', (event) => setOpen(menuButton.getAttribute('aria-expanded') !== 'true', event.detail > 0));
  nav?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !nav?.contains(event.target) && !menuButton?.contains(event.target)) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      menuButton.focus();
    }
  });
</script>

---
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { variant?: 'nav' | 'hero'; id: string; }
const { variant = 'nav', id } = Astro.props;
const placeholder = variant === 'hero' ? 'Search the catalog…' : 'Search catalog...';
---
<div class="catalog-search" data-search data-variant={variant} data-index-url={base + '/search-index.json'}>
  <span class="search-icon"><Icon name="search" /></span>
  <input id={id} type="search" autocomplete="off" maxlength="1000" placeholder={placeholder} aria-label="Search the catalog" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={id + '-results'} data-search-input />
  <div class="search-panel" data-search-panel tabindex="-1" hidden>
    <div class="search-status" role="status" aria-live="polite" data-search-status></div>
    <div id={id + '-results'} role="listbox" aria-label="Search results" data-search-results></div>
  </div>
</div>
<script>
  const htmlCharacters = /[&<>"']/g;
  const bengaliBlock = /[ঀ-৿]/;
  const whitespace = /\s+/;
  // One shared index fetch across every mounted instance.
  type SearchRecord = {
    type: string; name: string; meta: string; href: string; keywords?: string;
  };
  let index: SearchRecord[] | null = null;
  let pending: Promise<void> | null = null;
  const pageSize = 40;

  const esc = (s: string) =>
    String(s).replace(
      htmlCharacters,
      (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );

  function load(url: string) {
    if (index) return Promise.resolve();
    if (!pending) {
      pending = fetch(url)
        .then((r) => {
          if (!r.ok) throw new Error('Search index unavailable');
          return r.json();
        })
        .then((j) => {
          if (!Array.isArray(j) || !j.every((r) =>
            r && ['type', 'name', 'meta', 'href'].every((key) => typeof r[key] === 'string') &&
            (r.keywords === undefined || typeof r.keywords === 'string')
          )) throw new Error('Invalid search index');
          index = j;
        })
        .catch(() => {
          pending = null;
        });
    }
    return pending;
  }

  document.querySelectorAll<HTMLElement>('[data-search]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const panel = root.querySelector<HTMLElement>('[data-search-panel]');
    const results = root.querySelector<HTMLElement>('[data-search-results]');
    const status = root.querySelector<HTMLElement>('[data-search-status]');
    if (!input || !panel || !results || !status) return;

    const indexUrl = root.dataset.indexUrl!;
    let active = -1;
    let options: HTMLAnchorElement[] = [];
    let selectedOption: HTMLAnchorElement | null = null;
    let hits: SearchRecord[] = [];
    let rendered = 0;
    let first = 0;
    let revision = 0;

    function select(next: number, scroll = true) {
      active = next;
      const option = options[active] ?? null;
      if (selectedOption !== option) {
        selectedOption?.setAttribute('aria-selected', 'false');
        option?.setAttribute('aria-selected', 'true');
        selectedOption = option;
      }
      if (option) {
        input!.setAttribute('aria-activedescendant', option.id);
        if (scroll) option.scrollIntoView({ block: 'nearest' });
      } else input!.removeAttribute('aria-activedescendant');
    }

    function rangeMarkup(start: number, end: number) {
      return hits.slice(start, end).map((r, offset) => {
        const i = start + offset;
        return '<a id="' + input!.id + '-option-' + i + '" role="option" aria-selected="false" tabindex="-1" href="' + esc(r.href) + '" class="search-option">' +
          '<span class="badge">' + esc(r.type) + '</span>' +
          '<span class="search-option-body"><span class="search-name' + (bengaliBlock.test(r.name) ? ' bn" lang="bn' : '') + '">' + esc(r.name) + '</span>' +
          '<span class="search-meta' + (bengaliBlock.test(r.meta) ? ' bn" lang="bn' : '') + '">' + esc(r.meta) + '</span></span></a>';
      }).join('');
    }

    function announce() {
      status!.textContent = `${hits.length} ${hits.length === 1 ? 'result' : 'results'}. Showing ${first + 1} to ${rendered}. Press Enter to open.`;
    }

    function appendNextPage() {
      if (rendered >= hits.length) return;
      const end = Math.min(rendered + pageSize, hits.length);
      const markup = rangeMarkup(rendered, end);
      const previousCount = results!.children.length;
      results!.insertAdjacentHTML('beforeend', markup);
      options.push(...Array.from(results!.children).slice(previousCount) as HTMLAnchorElement[]);
      rendered = end;
      announce();
    }

    function showPage(start: number) {
      if (results!.contains(document.activeElement)) panel!.focus({ preventScroll: true });
      select(-1, false);
      options = [];
      results!.replaceChildren();
      first = start;
      rendered = start;
      appendNextPage();
    }

    function prependPreviousPage() {
      if (!first) return;
      const start = Math.max(0, first - pageSize);
      const count = first - start;
      const height = panel!.scrollHeight;
      results!.insertAdjacentHTML('afterbegin', rangeMarkup(start, first));
      options.unshift(...Array.from(results!.children).slice(0, count) as HTMLAnchorElement[]);
      if (active >= 0) active += count;
      first = start;
      panel!.scrollTop += panel!.scrollHeight - height;
      announce();
    }

    function close() {
      revision++;
      panel!.hidden = true;
      input!.setAttribute('aria-expanded', 'false');
      select(-1, false);
    }

    async function render() {
      const current = ++revision;
      const q = input!.value.trim().toLowerCase();
      if (q.length < 2 || document.activeElement !== input) {
        close();
        return;
      }
      select(-1, false);
      options = [];
      selectedOption = null;
      hits = [];
      rendered = 0;
      first = 0;
      results!.replaceChildren();
      panel!.hidden = false;
      input!.setAttribute('aria-expanded', 'true');
      if (!index) {
        status!.textContent = 'Loading search results...';
        await load(indexUrl);
        if (current !== revision) return;
        if (!index) {
          status!.textContent = 'Search could not load. Type again to retry, or browse the catalog using the menu.';
          return;
        }
      }
      const terms = q.split(whitespace);
      const rank = (name: string) => {
        return name === q ? 0 : name.startsWith(q) ? 1 : name.includes(q) ? 2 : 3;
      };
      hits = index
        .filter((r) => {
          const searchable = `${r.name} ${r.meta} ${r.keywords ?? ''}`.toLowerCase();
          return terms.every((term) => searchable.includes(term));
        })
        .sort((a, b) => rank(a.name.toLowerCase()) - rank(b.name.toLowerCase()));

      panel!.scrollTop = 0;
      if (hits.length) appendNextPage();
      else status!.textContent = 'No matches in the catalog. Try another name, author, or task.';
    }

    panel.addEventListener('scroll', () => {
      if (panel.scrollTop < 80 && first > 0) prependPreviousPage();
      if (panel.scrollHeight - panel.scrollTop - panel.clientHeight < 80) appendNextPage();
    }, { passive: true });

    input.addEventListener('focus', render);
    input.addEventListener('input', render);
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) close();
    });
    results.addEventListener('mouseover', (e) => {
      const option = (e.target as HTMLElement).closest<HTMLAnchorElement>('[role="option"]');
      if (option) select(options.indexOf(option), false);
    });
    results.addEventListener('focusin', (e) => {
      select(options.indexOf(e.target as HTMLAnchorElement), false);
    });
    results.addEventListener('click', (e) => {
      const option = (e.target as HTMLElement).closest<HTMLAnchorElement>('[role="option"]');
      close();
      // Reopen a filtered or collapsed target even when its hash has not changed.
      if (option?.href === location.href && !e.ctrlKey && !e.metaKey && !e.shiftKey && !e.altKey) {
        window.dispatchEvent(new HashChangeEvent('hashchange'));
      }
    });
    root.addEventListener('keydown', (e) => {
      if (e.isComposing) return;
      if (e.key === 'Tab') {
        close();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        input.focus();
        close();
      } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (panel.hidden) void render();
        if (options.length) {
          if (e.key === 'ArrowDown' && active === options.length - 1) {
            if (rendered < hits.length) appendNextPage();
            else if (first > 0) showPage(0);
          }
          if (e.key === 'ArrowUp' && active <= 0) {
            if (first > 0) prependPreviousPage();
            else {
              showPage(Math.max(0, hits.length - pageSize));
              active = options.length;
            }
          }
          select(e.key === 'ArrowDown'
            ? (active + 1) % options.length
            : (active < 0 ? options.length - 1 : (active - 1 + options.length) % options.length));
        }
        if (document.activeElement !== input) options[active]?.focus({ preventScroll: true });
      } else if (e.key === 'Enter' && !panel.hidden && document.activeElement === input && options.length) {
        e.preventDefault();
        options[active < 0 ? 0 : active].click();
      }
    });
  });
</script>

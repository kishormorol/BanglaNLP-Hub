---
/**
 * Shared document shell. Owns everything the prototype kept in <helmet>:
 * font loading, the no-flash theme script, and the shared BoardUI design tokens.
 */
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import readingFont from '../assets/fonts/sourcesans3-latin.woff2';
import displayFont from '../assets/fonts/newsreader-latin.woff2';
import bengaliFont from '../assets/fonts/noto-serif-bengali-bengali.woff2';
import monoFont from '../assets/fonts/geist-mono-latin.woff2';

interface Props {
  title: string;
  description?: string;
  active?: string;
}
const {
  title,
  description = 'Papers, datasets, models, tools, and benchmarks for Bengali natural language processing — community-maintained, link-verified, and open on GitHub.',
  active = '',
} = Astro.props;

// Absolute URLs for social cards. Astro.site + BASE_URL keep these correct
// under the project Pages path; og:image must be absolute or crawlers drop it.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <link rel="preload" href={readingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bengaliFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <!-- Open Graph / Twitter social card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BanglaNLP Hub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BanglaNLP Hub — a catalog of Bangla NLP resources" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" sizes="any" href={base + '/favicon.ico'} />
    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    <!-- Restore the saved or system theme before first paint. -->
    <script is:inline>
      // Keep the fallback fade disabled after a native page transition finishes.
      window.addEventListener('pagereveal', (event) => {
        if (event.viewTransition) document.documentElement.classList.add('native-navigation');
      });
      try {
        const theme = localStorage.bnlpTheme;
        const dark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteNav active={active} />
    <div id="main-content" tabindex="-1"><slot /></div>
    <Footer />
  </body>
</html>
